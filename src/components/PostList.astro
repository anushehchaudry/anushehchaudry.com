---
import type { CollectionEntry } from "astro:content";

interface Props {
  posts: CollectionEntry<"writing">[];
}

const { posts } = Astro.props;
const fmt = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });
---

{posts.length === 0 ? (
  <p class="muted">Nothing here yet. The first entry is on its way.</p>
) : (
  <ul class="plain posts">
    {posts.map((post) => (
      <li>
        <a href={`/writing/${post.id}`}>{post.data.title}</a>
        <span class="label">{fmt.format(post.data.date)}</span>
        <p class="muted">{post.data.description}</p>
      </li>
    ))}
  </ul>
)}

<style>
  .posts li { margin-bottom: 1.4rem; }
  .posts a { font-size: 1.25rem; margin-right: 0.6rem; }
  .posts p { margin: 0.2rem 0 0; font-size: 1rem; }
</style>
