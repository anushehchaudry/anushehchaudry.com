---
import Base from "../layouts/Base.astro";
---

<Base title="Teaching" description="Courses Anusheh Chaudry has taught at Stanford.">
  <div class="row">
    <div class="stamp"><span class="label">Index</span></div>
    <div class="body">
      <h1>Teaching</h1>
      <p class="lede">
        I've taught at Stanford since 2022: first a course I brought back and redesigned, now a new course on AI agents.
      </p>
    </div>
  </div>

  <section>
    <article class="row" data-topics="teaching ml">
      <div class="stamp">
        <span class="label">2026 – now</span><br />
        <span class="label">Course assistant</span>
      </div>
      <div class="body">
        <p class="label">Stanford · CS 329Z</p>
        <h2>Engineering AI Agents</h2>
        <p>
          The first offering of a course on building LLM agents: retrieval, tool use and MCP, memory,
          multi-agent systems, evaluation, and safety. I mentor thirteen student project teams.
          I also designed the course's <em>paper video</em> assignment. Students pick a research paper on agents,
          explain it on video, and then extend its ideas themselves.
        </p>
      </div>
    </article>

    <article class="row" data-topics="teaching products">
      <div class="stamp">
        <span class="label">2022 – 2025</span><br />
        <span class="label">Lead instructor</span>
      </div>
      <div class="body">
        <p class="label">Stanford · CS 51 &amp; CS 52</p>
        <h2>CS + Social Good Studio</h2>
        <p>
          A course run entirely by students, with no faculty involvement. It stopped being taught in 2022; I rewrote the curriculum, brought it back, and taught it through 2025.
          It covered user-centered design, AI, and app development with React Native, Swift, and Figma.
          Student teams partnered with health-tech and ed-tech organizations to build working prototypes for social-good projects.
        </p>
      </div>
    </article>
  </section>
</Base>
