---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" noindex>
  <div class="row">
    <div class="stamp"><span class="label">Error 404</span></div>
    <div class="body">
      <h1>This page isn't in the notebook.</h1>
      <p class="lede">It may have moved, or the link has a typo.</p>
      <ul class="plain arrow-links">
        <li><a href="/">Home</a></li>
        <li><a href="/work">Work</a></li>
        <li><a href="/projects">Projects</a></li>
        <li><a href="mailto:anushehchaudry@gmail.com">Email me</a></li>
      </ul>
    </div>
  </div>
</Base>
