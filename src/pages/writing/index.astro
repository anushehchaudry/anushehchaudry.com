---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";

const posts = ((await getCollection("writing", ({ data }) => !data.draft)) ?? [])
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Writing" noindex={posts.length === 0} description="Notes and essays by Anusheh Chaudry on AI agents, healthcare, and teaching.">
  <div class="row">
    <div class="stamp"><span class="label">Index</span></div>
    <div class="body">
      <h1>Writing</h1>
      <p class="lede">Notes on AI agents, health, teaching, and whatever I'm figuring out.</p>
      <p class="arrow-links"><a href="/rss.xml">Subscribe via RSS</a></p>
    </div>
  </div>

  <div class="row">
    <div class="stamp"><span class="label">Entries</span></div>
    <div class="body"><PostList posts={posts} /></div>
  </div>
</Base>
