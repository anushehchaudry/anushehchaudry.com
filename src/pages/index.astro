---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ProjectEntry from "../components/ProjectEntry.astro";
import PostList from "../components/PostList.astro";
import { jobs } from "../data/experience";

const projects = (await getCollection("projects"))
  .filter((e) => e.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const posts = ((await getCollection("writing", ({ data }) => !data.draft)) ?? [])
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base>
  <section>
    <div class="row">
      <div class="stamp"><span class="label">Introduction</span></div>
      <div class="body">
        <h1 class="intro">
          <span class="label kicker">Anusheh Chaudry · Machine learning engineer</span>
          I build LLM agents and model-serving infrastructure. Much of my earlier ML work was in health.
        </h1>
        <ul class="plain arrow-links socials">
          <li><a href="mailto:anushehchaudry@gmail.com">Email</a></li>
          <li><a href="https://github.com/anushehchaudry">GitHub</a></li>
          <li><a href="https://www.linkedin.com/in/anushehchaudry">LinkedIn</a></li>
          <li><a href="/about">More about me</a></li>
        </ul>
        <figure class="photo home-photo">
          <div class="print">
            <img
              src="/photos/graduation.jpg"
              alt="Anusheh in a white dress and a red Stanford stole, holding her graduation cap beside a sandstone column"
              width="900"
              height="1125"
            />
          </div>
          <figcaption class="figcap">Fig. 0: Graduation, Stanford</figcaption>
        </figure>
        <p>
          I'm a machine learning engineer. Most recently I built agent features for Surfboard at Artemis Software Works;
          before that I was a software engineer on AWS Bedrock, working on the infrastructure that serves Anthropic's models.
          I'm finishing my master's in computer science at Stanford, where I also teach.
        </p>
        <p class="strengths label">LLM agents · Inference infrastructure · ML for healthcare · Teaching</p>
      </div>
    </div>

    <div class="row">
      <div class="stamp">
        <span class="label">Currently</span><br />
        <span class="note">Nov&nbsp;2026</span>
      </div>
      <div class="body">
        <div class="sticky">
        <ul class="current">
          <li>Course assistant for <a href="/teaching">CS&nbsp;329Z: Engineering AI Agents</a></li>
          <li>Finishing my MS in Computer Science at Stanford (expected Mar 2027)</li>
        </ul>
        <p class="arrow-links"><a href="/now">What I'm up to</a></p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="row">
      <div class="stamp"><span class="label">Work</span></div>
      <div class="body">
        <h2>Where I've worked</h2>
        <ul class="plain jobs">
          {jobs.map((job) => (
            <li data-topics={job.topics.join(" ")}>
              <span class="job-role">{job.role}</span>
              <span class="job-co">{job.company}</span>
              <span class="job-hl">{job.highlight}</span>
              <span class="label">{job.when}</span>
            </li>
          ))}
        </ul>
        <p class="arrow-links"><a href="/work">Full work history</a></p>
      </div>
    </div>
  </section>

  <section>
    <div class="row section-head">
      <div class="stamp"><span class="label">Selected projects</span></div>
      <div class="body"><h2>Projects and research</h2></div>
    </div>
    {projects.map((entry, i) => <ProjectEntry entry={entry} number={i + 1} />)}
    <div class="row">
      <div class="stamp"></div>
      <div class="body arrow-links"><a href="/projects">All projects</a></div>
    </div>
  </section>

  <section>
    <div class="row" data-topics="teaching">
      <div class="stamp"><span class="label">Teaching</span></div>
      <div class="body">
        <h2>Teaching</h2>
        <p>
          After <em>CS + Social Good Studio</em> stopped being taught in 2022, I rewrote its curriculum and brought it back, then taught it through 2025. It's a Stanford course run entirely by students.
          Student teams designed and built apps with health-tech and ed-tech partners.
          This year I'm helping teach the first offering of a course on engineering AI agents.
        </p>
        <p class="arrow-links"><a href="/teaching">Courses</a></p>
      </div>
    </div>
  </section>

  {posts.length > 0 && <section>
    <div class="row">
      <div class="stamp"><span class="label">Writing</span></div>
      <div class="body">
        <h2>Notes &amp; essays</h2>
        <PostList posts={posts} />
        <p class="arrow-links"><a href="/writing">All writing</a></p>
      </div>
    </div>
  </section>}
</Base>

<style>
  .row:first-child .body { display: flow-root; } /* keep the floated photo in the intro */
  .home-photo { --photo-tape: var(--tape-2); width: 13.5rem; margin-top: 0.25rem; }
  .home-photo .print { transform: rotate(-1.6deg); }
  .intro {
    font-size: clamp(1.7rem, 3.6vw, 2.35rem);
    line-height: 1.22;
    margin-bottom: 1.1rem;
  }
  /* "Currently" is a sticky note stuck to the page */
  .sticky {
    max-width: 30rem;
    padding: 1rem 1.25rem 0.75rem;
    background: var(--sticky);
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.06), 0 8px 16px -10px rgba(0, 0, 0, 0.25);
    transform: rotate(-0.8deg);
  }
  .sticky .arrow-links { margin-bottom: 0; }
  .current { padding-left: 1.1rem; margin: 0 0 0.75rem; }
  .current li { margin-bottom: 0.3rem; }
  .current li::marker { content: "– "; color: var(--muted); }
  .kicker { display: block; margin-bottom: 0.6rem; }
  .socials { margin: -0.25rem 0 1.25rem; }
  .jobs { margin-bottom: 1rem; }
  .jobs li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .job-role { color: var(--ink); }
  .job-co { grid-column: 1; font-size: 0.95rem; color: var(--muted); }
  .job-hl { grid-column: 1 / -1; font-size: 0.95rem; margin-top: 0.15rem; }
  .strengths { color: var(--ink); margin-top: -0.25rem; }
  .jobs .label { grid-column: 2; grid-row: 1; align-self: baseline; }
  .section-head { margin-bottom: 1.75rem; }

  @media (max-width: 760px) {
    .jobs li { grid-template-columns: minmax(0, 1fr); }
    .jobs .label { grid-column: 1; grid-row: auto; order: -1; }
    .strengths { text-transform: none; letter-spacing: 0; font-size: 0.95rem; font-family: var(--serif); }
  }
  .section-head h2 { margin: 0; }
</style>
